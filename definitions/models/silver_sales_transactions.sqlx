-- definitions/models/silver_sales_transactions.sqlx

config {
  type: "table",
  schema: "silver_layer",
  assertions: {
    uniqueKey: ["sale_id"],
    nonNull: ["sale_id", "cust_id", "product_id", "sale_timestamp"],
    rowConditions: [
      "total_cost = (quantity * unit_price)"
    ]
  }
}

-- We will use a Common Table Expression (CTE) to handle duplicates
WITH sales_with_row_number AS (
  SELECT
    *,
    ROW_NUMBER() OVER(PARTITION BY sale_id ORDER BY timestamp DESC) as rn
  FROM
    ${ref("sales_transactions")}
    ${when(incremental(), `WHERE _load_date >= (SELECT MAX(_load_date) FROM ${self()})`)}
)

SELECT
    -- (All your columns from before: sale_id, store_id, etc.)
    sale_id,
    store_id,
    CAST(cust_id AS INT64) AS cust_id,
    CAST(timestamp AS TIMESTAMP) AS sale_timestamp,
    _load_date,
    TRIM(cust_name) AS cust_name,
    LOWER(TRIM(email)) AS email,
    TRIM(contact) AS contact,
    TRIM(city) AS city,
    UPPER(TRIM(state)) AS state,
    UPPER(TRIM(country)) AS country,
    TRIM(loyalty) AS loyalty,
    product_id,
    TRIM(product) AS product,
    TRIM(product_category) AS product_category,
    CAST(qty AS INT64) AS quantity,
    CAST(unit_price AS NUMERIC) AS unit_price,
    CAST(total_cost AS NUMERIC) AS total_cost
FROM 
  sales_with_row_number
WHERE 
  rn = 1 -- This is the magic line that filters for only the first occurrence of each sale_id